# Production: your Render (or other) Socket.IO / HTTP API origin — no trailing slash
REACT_APP_API_URL=https://your-backend.onrender.com

# Local backend
# REACT_APP_API_URL=http://localhost:5000

# ⚠️ Do NOT add an admin token here. Create React App inlines every REACT_APP_*
# variable into the public JS bundle, so it would be readable by any visitor.
# The admin panel signs in at /admin with ADMIN_USERNAME + ADMIN_PASSWORD_HASH
# (configured on the SERVER) and stores a short-lived session token in the browser.
