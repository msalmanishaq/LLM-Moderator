# ============================================================
# client/frontend/.env — copy to `.env` and fill in real values.
#
# Create React App reads REACT_APP_* at start/build time and inlines them into
# the public JS bundle.
#
# ⚠️ NEVER put a secret in a REACT_APP_* variable — anything here is readable by
# every visitor. The admin panel signs in at /admin against ADMIN_USERNAME +
# ADMIN_PASSWORD_HASH (configured on the SERVER) and holds a short-lived session
# token in the browser, so no secret is baked into the build.
# ============================================================

# Backend Socket.IO / HTTP API origin — no trailing slash.
# Production (Render or other host):
REACT_APP_API_URL=https://your-backend.onrender.com

# Local backend:
# REACT_APP_API_URL=http://localhost:5000

# Legacy alias kept in the deployed .env files. Nothing in src/ reads it — only
# REACT_APP_API_URL is used. Set it to the same origin if you want them to match.
# REACT_APP_SERVER_URL=https://your-backend.onrender.com
