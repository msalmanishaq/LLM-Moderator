# ============================================================
# server/.env — copy to `.env` and fill in real values.
# Never commit the filled-in file; `.gitignore` already excludes it.
#
# Keys are grouped exactly like the live server/.env. Values shown after `=`
# are either placeholders (replace them) or the code default (safe to leave).
# ============================================================


# ====================
# SUPABASE CONFIGURATION
# ====================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Direct Postgres connection, used by database_migrations.py.
# URL-encode special characters in the password (e.g. `#` -> `%23`).
DATABASE_URL=postgresql://postgres:<url-encoded-password>@db.your-project-id.supabase.co:5432/postgres

# Supabase Storage bucket holding voice recordings. Default: voice-recordings
AUDIO_BUCKET=voice-recordings


# ====================
# LLM PROVIDER CONFIGURATION (Groq primary)
# ====================
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=2000
# Retries on a failed Groq call. Default: 3
GROQ_MAX_RETRIES=3

GROQ_API_KEY=gsk_your-groq-api-key

# OpenAI is the fallback chat provider and the fallback TTS/STT provider.
# Leave commented out to force Groq-only operation with graceful failure.
# OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000


# ====================
# TEXT-TO-SPEECH (TTS) PROVIDERS
# ====================
# 'uplift' (Pakistani Urdu voices) or 'openai'.
TTS_PROVIDER=uplift

# Uplift API key. voice_providers.py accepts UPLIFTAI_API_KEY first, then
# UPLIFT_API_KEY; config.py reads only UPLIFT_API_KEY — set UPLIFT_API_KEY.
UPLIFT_API_KEY=sk_api_your-uplift-api-key
# UPLIFTAI_API_KEY=

# Seconds before an Uplift call is treated as failed. Healthy synthesis is ~1-3s.
UPLIFT_TIMEOUT=20

# Voice ids. A wrong (Indian) voice id is the usual cause of a Hindi-sounding
# moderator — use a *Pakistani* Urdu voice.
UPLIFT_VOICE_ID_URDU=v_your-pakistani-urdu-voice-id
UPLIFT_ROMAN_URDU_VOICE_ID=your-pakistani-urdu-voice-id
UPLIFT_VOICE_ID_EN=broadband-support

# true -> Roman Urdu MUST use Uplift; on failure the clip is skipped rather than
# voiced by OpenAI's Hindi-accented English voice. Default: true
FORCE_UPLIFT_FOR_URDU=true

# Optional Uplift overrides — defaults are fine for most deployments.
# UPLIFT_TTS_URL=https://api.upliftai.org/v1/synthesis/text-to-speech
# UPLIFT_DEFAULT_VOICE=broadband-support
# UPLIFT_URDU_VOICE=
# UPLIFT_ENGLISH_VOICE=
# UPLIFT_SINDHI_VOICE=
# UPLIFT_OUTPUT_FORMAT=MP3_22050_128
# UPLIFT_MAX_TEXT_LENGTH=4000

# true (default) -> transliterate Roman Urdu to Urdu script before sending to
# Uplift, for native pronunciation. Chat and the messages table stay Roman Urdu
# (research data) — only the spoken audio uses Urdu script.
# URDU_SCRIPT_TTS=true

# OpenAI TTS fallback settings.
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy


# ====================
# FRONTEND CONFIGURATION
# ====================
# CORS / Socket.IO origin. Production example:
# FRONTEND_URL=https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000


# ====================
# MODERATION MODES
# ====================
ACTIVE_MODE=active
PASSIVE_MODE=passive


# ====================
# STORY PROGRESSION
# ====================
ACTIVE_STORY_STEP=1
PASSIVE_STORY_STEP=1
STORY_CHUNK_INTERVAL=10


# ====================
# SILENCE / INTERVENTION SETTINGS (seconds)
# ====================
ACTIVE_SILENCE_SECONDS=20
PASSIVE_SILENCE_SECONDS=10
ACTIVE_INTERVENTION_WINDOW_SECONDS=20
PASSIVE_INTERVENTION_WINDOW_SECONDS=10


# ====================
# CHAT SETTINGS
# ====================
CHAT_HISTORY_LIMIT=50


# ====================
# MESSAGES
# ====================
WELCOME_MESSAGE=Welcome everyone! I'm the Moderator.
ACTIVE_ENDING_MESSAGE=✨ We have reached the end of the story.
PASSIVE_ENDING_MESSAGE=✨ We have reached the end of the story.


# ====================
# ENDING STYLES
# ====================
ACTIVE_ENDING_STYLE=warm
PASSIVE_ENDING_STYLE=warm


# ====================
# ROOM SETTINGS
# ====================
MAX_PARTICIPANTS_PER_ROOM=3
ROOM_IDLE_TIMEOUT_MINUTES=60


# ====================
# FEATURE FLAGS
# ====================
ENABLE_TTS=false
ENABLE_STT=false
ENABLE_AUTO_START_SINGLE_USER=true
ENABLE_CHAT_EXPORT=true
AUTO_START_STORY=true
ALLOW_ANONYMOUS_JOIN=true


# ====================
# SERVER CONFIGURATION
# ====================
# app.py binds to $PORT (Render/Heroku set this automatically). Default: 5000
# PORT=5000
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# Force the Socket.IO async mode (e.g. eventlet, gevent, threading).
# Leave unset to auto-detect.
# SOCKETIO_ASYNC_MODE=

# true -> boot even when database migrations have not been applied. Default: false
# ALLOW_UNMIGRATED=false

# true -> block writes to the frozen research schema. Default: false
# RESEARCH_READ_ONLY=false


# ====================
# ADMIN PANEL
# ====================
ENABLE_ADMIN_API=true

# ---- Admin panel login (username + password) ----
# Generate the hash — never store the plaintext:
#     cd server && python admin_auth.py hash
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2_sha256$390000$<salt-hex>$<hash-hex>

# Plaintext fallback, only used when ADMIN_PASSWORD_HASH is unset. Prefer the hash.
# ADMIN_PASSWORD=

# Signs session tokens. Optional — if unset it is derived from the password hash.
# Set it explicitly to invalidate all sessions on demand:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SESSION_SECRET=

# How long a login lasts before the panel asks for the password again.
ADMIN_SESSION_TTL_HOURS=12

# Legacy raw token, still accepted as the X-Admin-Token header so curl/export
# scripts keep working without a login. Use a long random value:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=your-long-random-admin-token


# ====================
# AUDIO / VAD TUNING (optional)
# ====================
# Voice-activity detection thresholds used by audio_preprocessor.py.
# VAD_RMS_THRESHOLD=100.0
# VAD_SPEECH_RATIO=0.20


# ====================
# DEV SCRIPTS (optional)
# ====================
# Base URL used by server/scripts/*.py against a running server.
# MODERATOR_API_BASE=http://127.0.0.1:5000
